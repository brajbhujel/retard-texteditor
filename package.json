{
  "name": "retard-texteditor",
  "version": "1.0.0",
  "description": "Notion-like block editor — Retard API over the Blok engine. Install and mount.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "browser": "./dist/retard-editor.umd.js",
  "types": "./src/index.d.ts",
  "unpkg": "./dist/retard-editor.umd.js",
  "jsdelivr": "./dist/retard-editor.umd.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./bundle": "./dist/retard-editor.mjs",
    "./umd": "./dist/retard-editor.umd.js",
    "./styles.css": "./src/styles/sdk.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/API.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "npm run build && npm run dev --prefix apps/web",
    "dev:static": "npm run build && node scripts/server.mjs --website",
    "start": "npm run start --prefix apps/web",
    "build": "node scripts/build.mjs",
    "build:web": "npm run build && npm run build --prefix apps/web",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "preview": "npm run build:web && npm run start --prefix apps/web",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "editor",
    "block-editor",
    "rich-text",
    "wysiwyg",
    "contenteditable",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brajbhujel/retard-texteditor.git"
  },
  "bugs": {
    "url": "https://github.com/brajbhujel/retard-texteditor/issues"
  },
  "homepage": "https://github.com/brajbhujel/retard-texteditor#readme",
  "author": "brajbhujel",
  "license": "MIT",
  "dependencies": {
    "@bloklabs/core": "^2.1.0"
  }
}
